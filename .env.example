# SNEWS Kafka Configuration
# Copy this file to .env and modify as needed

# Kafka Connection
# Local development (Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Real NASA GCN - uncomment when you have credentials.
# GCN issues separate client credential pairs for producing vs. consuming -
# they are NOT interchangeable, set both.
# GCN_PRODUCER_CLIENT_ID=your-producer-client-id
# GCN_PRODUCER_CLIENT_SECRET=your-producer-client-secret
# GCN_CONSUMER_CLIENT_ID=your-consumer-client-id
# GCN_CONSUMER_CLIENT_SECRET=your-consumer-client-secret
# USE_GCN_CREDENTIALS=true
# GCN_DOMAIN=test.gcn.nasa.gov
# Options: test.gcn.nasa.gov (test notices, default), gcn.nasa.gov (production), dev.gcn.nasa.gov

# Kafka Topics
SNEWS2_GCN_TOPIC=gcn.notices.snews2.alert
SNEWS2_TOPIC=snews2-alerts

# Producer Settings
KAFKA_ACKS=all
KAFKA_RETRIES=3

# Consumer Settings
KAFKA_CONSUMER_GROUP=snews2-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
